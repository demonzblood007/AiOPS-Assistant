# LLM
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# GitHub
GITHUB_TOKEN=ghp_your-token-here

# Redis
REDIS_URL=redis://localhost:6379/0

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
