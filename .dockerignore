.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Testing and docs (not needed in container)
.pytest_cache/
.coverage
htmlcov/
*.md
!README.md

# Docker (avoid recursive copy)
Dockerfile
docker-compose*.yml
.dockerignore

# Logs and temp
*.log
.cursor/
